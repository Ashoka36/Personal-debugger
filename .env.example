# AI Superbrain Debugger - Environment Variables

# Application Configuration
NODE_ENV=development
PORT=3000

# OAuth Configuration (Required for authentication)
VITE_APP_ID=your-app-id
JWT_SECRET=your-jwt-secret-key-here
OAUTH_SERVER_URL=https://oauth.manus.computer

# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/ai_debugger

# Owner Configuration
OWNER_OPEN_ID=your-open-id

# Built-in Forge API (Optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
